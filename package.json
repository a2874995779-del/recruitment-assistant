{
  "name": "recruitment-assistant",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "tsx apps/api/src/index.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "package:windows": "npm run build && node scripts/package-windows.mjs",
    "start": "node dist/apps/api/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/domain/*.test.ts tests/integration/*.test.ts tests/recovery/*.test.ts tests/contract/*.test.ts",
    "check": "npm run typecheck && npm test",
    "demo": "tsx scripts/demo.ts",
    "desktop": "npm run desktop:install && npm run build && electron dist/apps/desktop/src/main/index.js",
    "desktop:install": "node node_modules/electron/install.js",
    "desktop:smoke": "npm run desktop:install && npm run build && tsx scripts/desktop-smoke.ts",
    "salary:smoke": "npm run desktop:install && npm run build && tsx scripts/salary-ocr-smoke.ts",
    "salary:font-research": "tsx scripts/salary-font-research.ts",
    "api:smoke": "npm run build && tsx scripts/api-smoke.ts",
    "restore": "tsx scripts/restore.ts",
    "preview": "npm run build && tsx apps/preview/src/index.ts",
    "public:smoke": "tsx scripts/public-smoke.ts"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "cheerio": "^1.2.0",
    "fastify": "5.12.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "44.7.0",
    "opentype.js": "^2.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "^8.3.4"
  }
}
