# PowerShell example: $env:RA_PORT='4318'; npm.cmd run dev
RA_PORT=4318
# Defaults to %LOCALAPPDATA%/RecruitmentAssistant. Never use the source folder.
# RA_DATA_DIR=C:/Users/your-name/AppData/Local/RecruitmentAssistant
# Optional stable token (at least 32 characters). Otherwise generated in runtime api-token.
# RA_API_TOKEN=
